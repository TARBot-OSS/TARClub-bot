# ==========================================
# TARClub Bot Configuration
# ==========================================

# Discord Bot Token & Application ID
TARCLUB_DISCORD_TOKEN=your_discord_bot_token_here
TARCLUB_APPLICATION_ID=your_application_id_here

# Database Configuration (SQLite WAL mode)
TARCLUB_DATABASE_PATH=tarclub.db

# Cross-Bot Integration with TARVeri
TARCLUB_TARVERI_BOT_ID=1542166264561016963
TARCLUB_ENABLE_TARVERI_INTEGRATION=true
# Required to link: must equal TARVERI_BRIDGE_SECRET in TARVeri. Generate with: openssl rand -hex 32
TARCLUB_SHARED_SECRET=your_cross_bot_shared_secret

# Logging & Environment
TARCLUB_LOG_LEVEL=INFO
TARCLUB_ENVIRONMENT=development

# Optional: restart the bot inside this tmux pane when scripts/update.sh finishes (session:window.pane).
# The bot must run in the foreground in that pane. Leave unset to restart manually.
# TARCLUB_TMUX_TARGET=tarclub
# Optional: command typed into that pane to start the bot (default: venv python -m tarclub)
# TARCLUB_START_COMMAND=
